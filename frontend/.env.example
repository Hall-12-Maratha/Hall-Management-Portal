# =============================================================================
# Hall 12 Marathas Portal - Next.js full-stack environment variables
# =============================================================================
# Copy this file to .env.local and fill in your values. NEVER commit .env.local.
# On Vercel, add every variable below in Project Settings -> Environment Variables.

# --- Database (Supabase Postgres, transaction pooler on port 6543) -----------
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- JWT -----------------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Refresh-token cookie --------------------------------------------------------
# The API is same-origin now, so SameSite=lax is correct everywhere.
# COOKIE_SECURE defaults to true when NODE_ENV=production; set false only for local http.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Feature flags -----------------------------------------------------------------
# Server-side flag: enables GET /api/bookings/{id}/qr and POST /api/worker/scan.
QR_SCANNING_ENABLED=false
# Client-side flag (inlined at build time): shows the QR UI in the student history
# and worker scan pages. Keep both flags in sync.
NEXT_PUBLIC_QR_SCANNING_ENABLED=false

# --- SMTP (leave HOST/USER empty to log OTP emails to the console) -----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hall12.iitk.ac.in

# --- Seed script (npm run db:seed) ------------------------------------------------------
# Password for the initial hall_office admin (identifier: admin@hall12). Defaults to Hall12kaAdmin!
SEED_ADMIN_PASSWORD=
